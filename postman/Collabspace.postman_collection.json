        {
          "name": "Update member (leader)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "The last leader cannot be demoted (422).",
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/members/{{otherUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "members",
                "{{otherUserId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"leader\",\n  \"job_title\": \"Tech Lead\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
